{
  "name": "tx-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:generate && next dev --turbopack",
    "build": "npm run db:generate && next build --turbopack",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "pm2:dev": "DATABASE_URL=\"mysql://root:123123@localhost:3306/tx_website\" pm2 start npm --name \"tx-website-dev\" -- run dev",
    "pm2:build": "DATABASE_URL=\"mysql://root:123123@localhost:3306/tx_website\" npm run build && pm2 start npm --name \"tx-website\" -- start",
    "pm2:stop": "pm2 stop tx-website || pm2 stop tx-website-dev",
    "pm2:restart": "pm2 restart tx-website || pm2 restart tx-website-dev",
    "pm2:logs": "pm2 logs tx-website || pm2 logs tx-website-dev",
    "pm2:delete": "pm2 delete tx-website || pm2 delete tx-website-dev"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/extension-image": "^3.6.5",
    "@tiptap/extension-link": "^3.6.5",
    "@tiptap/extension-placeholder": "^3.6.5",
    "@tiptap/react": "^3.6.5",
    "@tiptap/starter-kit": "^3.6.5",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "15.5.4",
    "next-auth": "^4.24.10",
    "next-intl": "^4.3.9",
    "prisma": "^6.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-react": "^5.11.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-react": "^4.18.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.1.0"
}
