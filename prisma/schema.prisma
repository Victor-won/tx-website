// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(USER)
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String        @id @default(cuid())
  name        String
  nameEn      String?
  slug        String        @unique
  description String?       @db.Text
  descriptionEn String?     @db.Text
  image       String?
  model       CategoryModel @default(POST) // 分类模型类型
  parentId    String?
  parent      Category?     @relation("CategoryParent", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Category[]    @relation("CategoryParent")
  posts       Post[]
  products    Product[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Post {
  id            String     @id @default(cuid())
  title         String
  titleEn       String?
  content       String     @db.Text
  contentEn     String?    @db.Text
  excerpt       String?    @db.Text
  excerptEn     String?    @db.Text
  featuredImage String?
  status        PostStatus @default(DRAFT)
  authorId      String
  author        User       @relation(fields: [authorId], references: [id])
  categoryId    String?
  category      Category?  @relation(fields: [categoryId], references: [id])
  tags          Tag[]
  mediaFiles    MediaFile[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  publishedAt   DateTime?
}

model Product {
  id            String        @id @default(cuid())
  name          String
  nameEn        String?
  description   String        @db.Text
  descriptionEn String?       @db.Text
  shortDesc     String?       @db.Text
  shortDescEn   String?       @db.Text
  tag           String?       // 产品标签(核心产品、热门产品等)
  tagEn         String?       // 产品标签英文
  priceDisplay  String?       // 价格显示文本(如"联系获取")
  priceDisplayEn String?      // 价格显示文本英文
  rating        Decimal?      @db.Decimal(2, 1) // 产品评分(1.0-5.0)
  specifications Json?
  features      Json?         // 产品特性数组
  price         Decimal       @db.Decimal(10, 2)
  salePrice     Decimal?      @db.Decimal(10, 2)
  stock         Int           @default(0)
  status        ProductStatus @default(ACTIVE)
  featuredImage String?
  images        Json?
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id])
  tags          Tag[]
  mediaFiles    MediaFile[]
  order         Int           @default(0) // 排序顺序
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([order])
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  posts     Post[]
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model MediaFile {
  id        String         @id @default(cuid())
  name      String
  fileName  String
  url       String
  path      String         // 文件存储路径
  mimeType  String
  size      Int
  width     Int?           // 图片宽度
  height    Int?           // 图片高度
  alt       String?
  caption   String?
  folder    String?        // 文件夹分类
  fileType  MediaFileType  @default(OTHER) // 文件类型
  uploadedBy String?       // 上传者ID
  isPublic  Boolean        @default(true)  // 是否公开
  posts     Post[]
  products  Product[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([folder])
  @@index([fileType])
  @@index([mimeType])
  @@index([createdAt])
}

model Contact {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  subject   String
  message   String        @db.Text
  status    ContactStatus @default(PENDING)
  notes     String?       @db.Text // 管理员备注
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

enum Role {
  USER
  ADMIN
}

enum CategoryModel {
  POST     // 文章分类
  PRODUCT  // 产品分类
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum MediaFileType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  ARCHIVE
  OTHER
}

enum ContactStatus {
  PENDING    // 待处理
  REPLIED    // 已回复
  RESOLVED   // 已解决
  ARCHIVED   // 已归档
}

model Solution {
  id          String   @id @default(cuid())
  title       String
  titleEn     String?
  description String   @db.Text
  descriptionEn String? @db.Text
  icon        String   // 图标名称 (如 "Cpu", "Shield")
  color       String   // 渐变色 (如 "from-blue-500 to-blue-600")
  iconBg      String   // 图标背景色 (如 "bg-blue-600")
  features    Json?    // 特性列表
  order       Int      @default(0)
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@index([status])
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  nameEn    String?
  logo      String   // Logo 图片路径
  website   String?  // 官网链接
  order     Int      @default(0)
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@index([status])
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  titleEn     String?
  description String   @db.Text
  descriptionEn String? @db.Text
  highlight   String?  // 高亮标签
  highlightEn String?
  image       String   // 背景图片
  buttonText  String?  // 按钮文本
  buttonTextEn String?
  buttonLink  String?  // 按钮链接
  color       String   @default("from-blue-600 to-purple-700") // 渐变色
  order       Int      @default(0)
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@index([status])
}
